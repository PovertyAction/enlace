# ============================================================================
# REQUIRED: Anthropic API Configuration
# ============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=""  # Replace with your actual API key

# ============================================================================
# OPTIONAL: Semantic Augmentation Configuration
# ============================================================================

# --- LLM Configuration ---
# Haiku is 3x faster and 80% cheaper - recommended for RAG queries
# Sonnet provides higher quality for complex reasoning
AUGMENTATION_LLM_MODEL="claude-haiku-4-5-20251001"
AUGMENTATION_TEMPERATURE="0.1"  # Low temperature for factual extraction
AUGMENTATION_MAX_TOKENS="2048"

# --- Embedding Model Configuration ---
# Default: fast and lightweight (384 dimensions)
AUGMENTATION_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# Alternatives:
# - "sentence-transformers/all-mpnet-base-v2" (best quality, 768 dim, 4x slower)
# - "intfloat/e5-base-v2" (optimized for research papers)
# - "minishlab/potion-base-8M" (lightweight, 256 dim)

# --- Semantic Search Configuration ---
AUGMENTATION_CHUNK_SIZE="1000"  # Character chunk size for text splitting
AUGMENTATION_CHUNK_OVERLAP="200"  # Character overlap between chunks
AUGMENTATION_TOP_K="5"  # Number of chunks to retrieve per query
AUGMENTATION_SIMILARITY_THRESHOLD="0.3"  # Minimum similarity score (0-1)

# --- Feature Toggles ---
AUGMENTATION_VARIABLES="true"  # Extract variable context
AUGMENTATION_TREATMENTS="true"  # Extract treatment descriptions
AUGMENTATION_METHODS="true"  # Extract statistical methods
AUGMENTATION_STUDY_CONTEXT="true"  # Extract study design and sample info
AUGMENTATION_ENABLE_VALIDATION="true"  # Cross-validate parsed values

# --- Validation Configuration ---
AUGMENTATION_VALIDATION_THRESHOLD="0.05"  # 5% relative tolerance
AUGMENTATION_VALIDATION_ABS_THRESHOLD="0.01"  # Absolute tolerance for small values

# --- Performance Configuration ---
AUGMENTATION_USE_ASYNC="true"  # Enable async processing
AUGMENTATION_MAX_CONCURRENT="10"  # Max concurrent queries
AUGMENTATION_CACHE_EMBEDDINGS="true"  # Cache embeddings to disk
AUGMENTATION_CACHE_DIR="data/augmentation_cache"

# --- Output Configuration ---
AUGMENTATION_CITATIONS="true"  # Include source citations
AUGMENTATION_MIN_CONFIDENCE="0.5"  # Min confidence to include context
