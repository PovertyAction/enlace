# Anthropic API Configuration
ANTHROPIC_API_KEY = ""  # Replace with your actual API key
# Primary model for final summary synthesis (use Sonnet for highest quality)
# Haiku is 3x faster and 80% cheaper - recommended for RAG queries
# claude-haiku-4-5-20251001
# claude-sonnet-4-5-20250929
ANTHROPIC_MODEL = "claude-sonnet-4-5-20250929"  # Claude model for synthesis
ANTHROPIC_RAG_MODEL = "claude-haiku-4-5-20251001"  # Claude model for RAG

# Embedding Model Configuration
EMBEDDING_MODEL_NAME = "sentence-transformers/all-MiniLM-L6-v2"  # Default: fast and lightweight
# Alternatives:
# - "sentence-transformers/all-mpnet-base-v2" (best quality, 4x slower)
# - "intfloat/e5-base-v2" (optimized for research papers)

# Text Processing Configuration
CHUNK_SIZE = "2000"  # Character chunk size for text splitting
CHUNK_OVERLAP = "400"  # Character overlap between chunks

# Vector Store Configuration
PERSIST_DIRECTORY = "data/chroma"  # Directory for ChromaDB persistent storage
